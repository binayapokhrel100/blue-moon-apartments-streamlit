# ==================================================
# BLUE MOON APARTMENTS
# Environment Configuration Example
# ==================================================

# Application
APP_NAME=Blue Moon Apartments

# development or production
APP_ENV=development

# ==================================================
# DEVELOPMENT DATABASE
# ==================================================

# Local SQLite database
DATABASE_URL=sqlite:///blue_moon.db

# ==================================================
# PRODUCTION DATABASE
# ==================================================

# For Streamlit Community Cloud:
# Set APP_ENV=production
#
# Set DATABASE_URL in Streamlit Secrets.
# Use the actual Neon PostgreSQL connection URL.
#
# Required URL parameters:
# sslmode=verify-full
# channel_binding=require
#
# Never commit a real database connection URL.

# ==================================================
# APPLICATION SECRET
# ==================================================

# Development placeholder only.
# Production requires a securely generated secret
# containing at least 32 UTF-8 bytes.
SECRET_KEY=replace-with-your-secret-key

# ==================================================
# OPTIONAL DEMO ACCOUNT
# ==================================================

DEMO_USER_EMAIL=sarah.mitchell@bluemoon.demo
DEMO_USER_PASSWORD=replace-with-demo-password